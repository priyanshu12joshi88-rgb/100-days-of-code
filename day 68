  #include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);  // size of array

    int nums[n];
    for(int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }

   
    int expected_sum = n * (n + 1) / 2;

    // Actual sum of array
    int actual_sum = 0;
    for(int i = 0; i < n; i++) {
        actual_sum += nums[i];
    }

    int missing = expected_sum - actual_sum;
    printf("%d", missing);

    return 0;
}
